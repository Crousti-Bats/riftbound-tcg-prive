/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https://cmsassets.rgpub.io https://ddragon.leagueoflegends.com data:; script-src 'self'; style-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
