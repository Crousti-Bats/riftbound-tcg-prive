// Configuration Cloudflare (Wrangler). Les chemins sont relatifs à ce fichier.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riftbound-tcg",
  "main": "../serveur-api/point-entree-api.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Base SQLite Cloudflare D1 (région Europe de l'Ouest). L'identifiant n'est pas un secret.
  "d1_databases": [
    {
      "binding": "BASE_DE_DONNEES",
      "database_name": "riftbound-tcg",
      "database_id": "efbe0899-7a3f-4f63-aad4-4bd9c540eb2d",
      "migrations_dir": "../base-de-donnees/migrations"
    }
  ]
}
