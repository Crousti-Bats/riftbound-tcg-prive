{
  "name": "riftbound-tcg-prive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config configuration/vite-site-et-api.config.ts",
    "build": "npm run typecheck && vite build --config configuration/vite-site-et-api.config.ts",
    "preview": "vite preview --config configuration/vite-site-et-api.config.ts",
    "typecheck": "tsc -b configuration/typescript/tsconfig.json",
    "lint": "eslint --config configuration/qualite-code-eslint.config.js .",
    "test": "vitest run --config configuration/tests-vitest.config.ts",
    "test:watch": "vitest --config configuration/tests-vitest.config.ts",
    "cf-typegen": "wrangler types --config configuration/cloudflare-wrangler.jsonc serveur-api/types-cloudflare-generes.d.ts",
    "deploy": "npm run build && wrangler deploy --config dist/riftbound_tcg/wrangler.json",
    "admin:invitation": "node outils/creer-invitation-admin.mjs",
    "base:migrer-local": "wrangler d1 migrations apply riftbound-tcg --local --config configuration/cloudflare-wrangler.jsonc --persist-to .wrangler/state"
  },
  "dependencies": {
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
